LOCAL_DIR := $(GET_LOCAL_DIR)
MODULE := $(LOCAL_DIR)


GLOBAL_INCLUDES += \
	$(LOCAL_DIR)/include

PLATFORM := qogirn6pro

GLOBAL_DEFINES += \
	CONFIG_POWERKEY_DEFAULT_HIGH \
	CONFIG_BOARD_ID \
	CONFIG_32K_TYPE \
	CONFIG_WCN_DETECT \
	CONFIG_SSMH_WIFI_MODE \
	CONFIG_ANDROIDBOOT_HARDWARE \
	CONFIG_BAND_DETECT \
	CONFIG_PCB_VERSION \
	CONFIG_PMIC_CHIP_ID

# Fixme:For TR5 loglevel
GLOBAL_DEFINES += \
	CONFIG_FOR_LOGLEVEL

MODULE_SRCS += \
	$(LOCAL_DIR)/init.c \
	$(LOCAL_DIR)/modem_entry.c \
	$(LOCAL_DIR)/sdio_cfg.c \
	$(LOCAL_DIR)/pinmap.c \
	$(LOCAL_DIR)/regulator_init.c \
	$(LOCAL_DIR)/ldo_sleep.c \
	$(LOCAL_DIR)/ssmh.c \
	$(LOCAL_DIR)/sprd_uart_matrix_cfg.c \
	$(LOCAL_DIR)/sprd_usb_uart_mux_cfg.c

include make/module.mk
