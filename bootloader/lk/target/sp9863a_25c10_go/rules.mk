LOCAL_DIR := $(GET_LOCAL_DIR)
MODULE := $(LOCAL_DIR)

GLOBAL_INCLUDES += \
	$(LOCAL_DIR)/include

PLATFORM := sharkl3

GLOBAL_DEFINES += \
	CONFIG_POWERKEY_DEFAULT_HIGH \
	CONFIG_BOARD_ID \
	CONFIG_32K_TYPE \
	CONFIG_MUTI_DCDC


ifeq ($(SPRD_DUAL_DDR),1)
GLOBAL_DEFINES += PHYS_SDRAM_2 := 0x180000000	/* SDRAM Bank #2 or 0x90000000 0x480000000*/
GLOBAL_DEFINES += PHYS_SDRAM_2_SIZE := 0x20000000	/* 512 MB  or 0x10000000*/
endif

MODULE_SRCS += \
	$(LOCAL_DIR)/init.c \
	$(LOCAL_DIR)/modem_entry.c \
	$(LOCAL_DIR)/sdio_cfg.c \
	$(LOCAL_DIR)/pinmap.c \
	$(LOCAL_DIR)/ldo_sleep.c \
	$(LOCAL_DIR)/regulator_init.c \
	$(LOCAL_DIR)/ssmh.c

include make/module.mk
