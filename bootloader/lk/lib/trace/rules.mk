LOCAL_DIR := $(GET_LOCAL_DIR)

MODULE := $(LOCAL_DIR)

GLOBAL_DEFINES += \
	SPRD_TRACE=1

ifeq ($(PLATFORM),sharkl3)
GLOBAL_DEFINES += \
	TRACE_BUF_ADDR=0x92300000 \
    TRACE_BUF_SIZE=0x0BB80000
else ifeq ($(PLATFORM),sharkl5pro)
GLOBAL_DEFINES += \
    TRACE_BUF_ADDR=0x92300000 \
    TRACE_BUF_SIZE=0x0BB80000
else ifeq ($(PLATFORM),qogirl6)
GLOBAL_DEFINES += \
    TRACE_BUF_ADDR=0x92300000 \
    TRACE_BUF_SIZE=0x0BB80000
else ifeq ($(PLATFORM),qogirn6pro)
GLOBAL_DEFINES += \
    TRACE_BUF_ADDR=0xB4000000 \
    TRACE_BUF_SIZE=0x07E80000
else ifeq ($(PLATFORM),qogirn6l)
GLOBAL_DEFINES += \
    TRACE_BUF_ADDR=0xB4000000 \
    TRACE_BUF_SIZE=0x07E80000
endif

MODULE_SRCS += \
	$(LOCAL_DIR)/sprd_trace.c

include make/module.mk
