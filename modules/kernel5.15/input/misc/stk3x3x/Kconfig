
# STK3X3X start
config INPUT_STK3X3X_I2C
	tristate "STK3X3X proximity and light sensor device with I2C bus"
	depends on I2C
	default n
	help
	  Say Y here if you have a STK3X3X device on the board and use I2C
	  communication, else say N.

	  To compile this driver as a module, choose M here.  
# STK3X3X end
