@@ -46,6 +46,276 @@
 #include "audio_dump.h"


+#ifdef AWINIC_EFFECT_SUPPORT
+#include "AwinicAPI.h"
+#include <dlfcn.h>
+#include <string.h>
+#include <cutils/properties.h>
+#include <fcntl.h>
+#include <time.h>
+
+#define AWINIC_LIB_PATH "/vendor/lib/hw/awinic.audio.effect.so"
+#define AWINIC_PARAMS_PATH "/vendor/firmware/awinic_params.bin"
+
+/******************** Awinic Vmax Algo *********************/
+// Two Vmax functions are supported: node scheme (old version) and kcontrol scheme (new version)
+#define AW_VMAX_NODE_DEFAULT (false) //If the old version of Vmax function is selected, please set true.
+#define AW_VMAX_KCTL_DEFAULT (true)  //If the old version of Vmax function is selected, please set false.
+
+static char g_awinic_vmax_path[][128] = {
+	"/sys/bus/i2c/drivers/aw87xxx_pa/4-005b/vmax",	//If the old version of Vmax function is selected, please config
+	"/sys/bus/i2c/drivers/aw87xxx_pa/4-005c/vmax",	//If the old version of Vmax function is selected, please config
+};
+
+static char g_vmax_switch_kctrl_name[][32] = {
+	"aw87xxx_monitor_switch_0",
+	"aw87xxx_monitor_switch_1"
+};
+
+static char g_vmax_value_kctrl_name[][32] = {
+	"aw87xxx_vmax_get_0",
+	"aw87xxx_vmax_get_1"
+};
+
+#define AW_VMAX_DEV_MAX		(2)
+#define AW_VMAX_UPDATE_INTERVAL (5) //5s
+
+typedef struct timespec aw_timespec_t;
+typedef struct awinic_vmax_info {
+	bool node_enable;
+	bool kctl_enable;
+	int vmax_vol[AW_VMAX_DEV_MAX];
+	int vmax_fd[AW_VMAX_DEV_MAX];
+	aw_timespec_t pretime;
+	struct mixer_ctl *vmax_switch_ctl[AW_VMAX_DEV_MAX];
+	struct mixer_ctl *vmax_value_ctl[AW_VMAX_DEV_MAX];
+} aw_vmax_t;
+
+static aw_vmax_t g_aw_vmax = {
+	.node_enable = AW_VMAX_NODE_DEFAULT,
+	.kctl_enable = AW_VMAX_KCTL_DEFAULT,
+	.pretime = { 0 , 0 },
+	.vmax_vol = { 0 , 0 },
+	.vmax_fd = { -1, -1 },
+	.vmax_switch_ctl = {NULL, NULL},
+	.vmax_value_ctl = {NULL, NULL},
+};
+static int g_aw_dev_num = 1;
+
+static void aw_vamx_node_init(void)
+{
+	int i = 0;
+	int open_count = 0;
+	bool open_flag = false;
+
+	g_aw_vmax.pretime.tv_sec = 0;
+	if (g_aw_vmax.node_enable) {
+		if (g_aw_dev_num > AW_VMAX_DEV_MAX) {
+			ALOGI("%s: Awinic g_aw_dev_num[%d] set out range,using default[%d]\n",
+				__func__, g_aw_dev_num, AW_VMAX_DEV_MAX);
+			g_aw_dev_num = AW_VMAX_DEV_MAX;
+		}
+		for (i = 0; i < g_aw_dev_num; i++) {
+			if (g_awinic_vmax_path[i] == NULL) {
+				LOG_E("%s: Awinic vmax_path is NULL\n", __func__);
+			}
+			g_aw_vmax.vmax_fd[i] = open(g_awinic_vmax_path[i], O_RDONLY);
+			if (g_aw_vmax.vmax_fd[i] < 0) {
+				LOG_E("%s: Awinic open vmax failed\n", __func__);
+			} else {
+				open_count += 1;
+			}
+		}
+		if (open_count == g_aw_dev_num) {
+			open_flag = true;
+		} else {
+			open_flag = false;
+		}
+		g_aw_vmax.node_enable &= open_flag;
+		if (g_aw_vmax.node_enable == false) {
+			for (i = 0; i < g_aw_dev_num; i++) {
+				if (g_aw_vmax.vmax_fd[i] >= 0) {
+					close(g_aw_vmax.vmax_fd[i]);
+				}
+				g_aw_vmax.vmax_fd[i] = -1;
+			}
+			LOG_E("%s: Awinic vmax node init failed\n", __func__);
+		} else {
+			LOG_I("%s: Awinic vmax node init success\n", __func__);
+		}
+	}
+}
+
+static void aw_vamx_kctl_init(struct mixer *mMixer)
+{
+	int i = 0;
+	int open_count = 0;
+	unsigned int vmax_kctrl_enable = 0;
+	struct mixer_ctl *vmax_switch_ctl = NULL;
+	struct mixer_ctl *vmax_value_ctl = NULL;
+
+	g_aw_vmax.pretime.tv_sec = 0;
+	if (g_aw_vmax.kctl_enable) {
+		if (g_aw_dev_num > AW_VMAX_DEV_MAX) {
+			LOG_I("%s: Awinic g_aw_dev_num[%d] set out range,using default[%d]\n",
+				__func__, g_aw_dev_num, AW_VMAX_DEV_MAX);
+			g_aw_dev_num = AW_VMAX_DEV_MAX;
+		}
+		for (i = 0; i < g_aw_dev_num; i++) {
+			vmax_switch_ctl = mixer_get_ctl_by_name(mMixer, g_vmax_switch_kctrl_name[i]);
+			if (vmax_switch_ctl) {
+				g_aw_vmax.vmax_switch_ctl[i] = vmax_switch_ctl;
+				vmax_value_ctl = mixer_get_ctl_by_name(mMixer, g_vmax_value_kctrl_name[i]);
+				if (vmax_value_ctl) {
+					g_aw_vmax.vmax_value_ctl[i] = vmax_value_ctl;
+					open_count++;
+				} else {
+					LOG_I("%s: Awinic dev[%d]'s vmax value kcontrol is not accessible!\n",
+							__func__, i);
+					g_aw_vmax.vmax_value_ctl[i] = NULL;
+				}
+			} else {
+				g_aw_vmax.vmax_switch_ctl[i] = NULL;
+				LOG_I("%s: Awinic dev[%d]'s vmax switch kcontrol is not accessible!\n",
+						__func__, i);
+			}
+		}
+		if (open_count != g_aw_dev_num) {
+			g_aw_vmax.kctl_enable = false;
+			LOG_I("%s: Awinic vmax kcontrol is not accessible! please check!\n", __func__);
+		} else {
+			g_aw_vmax.kctl_enable = true;
+			LOG_I("%s: Awinic vmax kcontrol init success!\n", __func__);
+		}
+	}
+}
+
+static void aw_vmax_update_kctl(int *vmax_vol)
+{
+	int i = 0;
+	unsigned int vmax_kctrl_enable = 0;
+	struct mixer_ctl *vmax_switch_ctl = NULL;
+	struct mixer_ctl *vmax_value_ctl = NULL;
+
+	for (i = 0; i < g_aw_dev_num; i++) {
+		vmax_switch_ctl = g_aw_vmax.vmax_switch_ctl[i];
+		vmax_value_ctl = g_aw_vmax.vmax_value_ctl[i];
+
+		if (vmax_switch_ctl != NULL && vmax_value_ctl != NULL) {
+			vmax_kctrl_enable = mixer_ctl_get_value(vmax_switch_ctl, 0);
+			if (vmax_kctrl_enable) {
+				vmax_vol[i] = mixer_ctl_get_value(vmax_value_ctl, 0);
+			} else {
+				LOG_I("%s: Awinic rcv dev[%d] vmax disable\n", __func__, i);
+			}
+		}
+	}
+}
+
+static void aw_vmax_update_node(int *vmax_vol)
+{
+	char vmax_buf[64] = {0};
+	int i = 0;
+	int ret = 0;
+
+	for (i = 0; i < g_aw_dev_num; i++) {
+		ret = lseek(g_aw_vmax.vmax_fd[i], 0, SEEK_SET);
+		if (ret < 0) {
+			LOG_E("%s:Awinic lseek failed\n", __func__);
+			return;
+		}
+		ret = read(g_aw_vmax.vmax_fd[i], vmax_buf, sizeof(vmax_buf) - 1);
+		if (ret < 0) {
+			LOG_E("%s: Awinic read data failed\n", __func__);
+			return;
+		}
+		ret = sscanf(vmax_buf, "%x", &vmax_vol[i]);
+		if(ret == 1){
+			return;
+		} else {
+			LOG_D("%s: Awinic rcv dev[%d] vmax node vmax_buf:[%s], strtoint failed\n",
+				__func__, i, vmax_buf);
+		}
+	}
+}
+
+static void aw_vmax_update(aw_skt_t *m_awinic)
+{
+	aw_timespec_t curtime = {0,0};
+	aw_timespec_t *pretime = &g_aw_vmax.pretime;
+	int vmax_vol[AW_VMAX_DEV_MAX] = { 0 };
+	int i = 0;
+	int ret = 0;
+
+	clock_gettime(CLOCK_MONOTONIC, &curtime);
+	if (curtime.tv_sec - pretime->tv_sec < AW_VMAX_UPDATE_INTERVAL) {
+		return;
+	}
+	pretime->tv_sec = curtime.tv_sec;
+	if (g_aw_vmax.kctl_enable == true) {
+		aw_vmax_update_kctl(vmax_vol);
+	} else if (g_aw_vmax.node_enable == true) {
+		aw_vmax_update_node(vmax_vol);
+	} else {
+		return;
+	}
+
+	for (i = 0; i < g_aw_dev_num && vmax_vol[i] != g_aw_vmax.vmax_vol[i]; i++) {
+		ret = m_awinic->setVmax(m_awinic->module_context_buffer, vmax_vol[i], i);
+		if (ret < 0) {
+			LOG_E("%s:Awinic setVmax: %d[0x%08x] failed\n", __func__, vmax_vol[i], vmax_vol[i]);
+		} else {
+			LOG_I("%s:Awinic setVmax: %d[0x%08x] success\n", __func__, vmax_vol[i], vmax_vol[i]);
+			g_aw_vmax.vmax_vol[i] = vmax_vol[i];
+		}
+	}
+}
+
+void aw_vmax_deinit(void)
+{
+    int i = 0;
+
+    if (g_aw_vmax.node_enable == true) {
+        for (i = 0; i < g_aw_dev_num && g_aw_vmax.vmax_fd[i] >= 0; i++) {
+            close(g_aw_vmax.vmax_fd[i]);
+        }
+    }
+}
+
+int aw_init(struct tiny_audio_device *adev)
+{
+    adev->g_awinic_skt.awinic_lib = dlopen(AWINIC_LIB_PATH,RTLD_NOW);
+    if (adev->g_awinic_skt.awinic_lib == NULL) {
+        ALOGE("%s: Awinic Dlopen lib Failed !",__func__);
+        ALOGE("%s: Awinic Dlopen - %s !",__func__, dlerror());
+        return -1;
+    }
+    ALOGD("%s: Awinic open lib success !",__func__);
+
+    adev->g_awinic_skt.getalgoinfo = (AwGetAlgoInfo)dlsym(adev->g_awinic_skt.awinic_lib, "AwinicGetAlgoInfo");
+    adev->g_awinic_skt.getSize = (AwGetSize_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicGetSize");
+    adev->g_awinic_skt.init    = (AwInit_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicInit");
+    adev->g_awinic_skt.end     = (AwEnd_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicEnd");
+    adev->g_awinic_skt.reset     = (AwEnd_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicReset");
+    adev->g_awinic_skt.process = (AwHandle_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicHandle");
+    adev->g_awinic_skt.setMediaInfo = (AwSetMediaInfo_t)dlsym(adev->g_awinic_skt.awinic_lib,"AwinicSetMediaInfo");
+    adev->g_awinic_skt.setVmax = (AwSetVmax_t)dlsym(adev->g_awinic_skt.awinic_lib,"awinic_set_vmax");
+
+    if (adev->g_awinic_skt.getalgoinfo == NULL || adev->g_awinic_skt.getSize == NULL || adev->g_awinic_skt.init == NULL|| adev->g_awinic_skt.setMediaInfo==NULL
+        || adev->g_awinic_skt.end == NULL || adev->g_awinic_skt.process == NULL || adev->g_awinic_skt.reset == NULL ||
+        adev->g_awinic_skt.setVmax == NULL) {
+        ALOGE("%s: Awinic get skt function Failed !",__func__);
+        dlclose(adev->g_awinic_skt.awinic_lib);
+        adev->g_awinic_skt.awinic_lib = NULL;
+        return -1;
+    }
+    ALOGD("%s: Awinic open lib function success !",__func__);
+
+    ALOGD("%s: Awinic init success !",__func__);
+
+    return 0;
+}
+#endif
